        <mxCell id="L4Le4VmJKpCMgiI7e1Pn-83" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;" value="&lt;h2&gt;MATÉRIAS → ÁREAS → PROFISSÕES&lt;/h2&gt;&lt;h3&gt;DESENVOLVIMENTO&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;Matérias:&lt;/strong&gt; Introdução à Programação I, AEDs I e II, POO I e II, Sistemas Operacionais + Programação Web, Engenharia de Software I e II, Programação para Dispositivos Móveis, Projeto e Análise de Algoritmos + IA, Qualidade de Software.&lt;/p&gt;&lt;p&gt;→ &lt;strong&gt;Programador, Engenheiro de Software, Analista de Testes, Analista de Sistemas, Web Designer.&lt;/strong&gt;&lt;/p&gt;&lt;hr&gt;&lt;h3&gt;DADOS E INFRAESTRUTURA&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;Matérias:&lt;/strong&gt; Banco de Dados, Sistemas Digitais e Circuitos Combinacionais, Arquitetura e Organização de Computadores, Redes de Computadores + Sistemas Distribuídos.&lt;/p&gt;&lt;p&gt;→ &lt;strong&gt;Administrador de Banco de Dados, Administrador/Gerente de Redes, Analista de Sistemas, Engenheiro de Software.&lt;/strong&gt;&lt;/p&gt;&lt;hr&gt;&lt;h3&gt;&amp;nbsp;ANÁLISE E SISTEMAS&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;Matérias:&lt;/strong&gt; Sistemas de Apoio à Decisão, IHC + Gestão de Projetos, Probabilidade e Estatística, Matemática Discreta.&lt;/p&gt;&lt;p&gt;→ &lt;strong&gt;Analista de Sistemas, Analista de Requisitos, Analista de Negócios, Consultor de Sistemas de Informação, Gerente de Sistemas de Informação.&lt;/strong&gt;&lt;/p&gt;&lt;hr&gt;&lt;h3&gt;&amp;nbsp;GESTÃO&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;Matérias:&lt;/strong&gt; Princípios da Administração I, Contabilidade, Governança e Gestão da Informação, Empreendedorismo, Gestão de Projetos.&lt;/p&gt;&lt;p&gt;→ &lt;strong&gt;Gerente de Projetos, Gerente de Sistemas de Informação, Analista de Negócios, Consultor de Sistemas de Informação, Empresário na Área de SI.&lt;/strong&gt;&lt;/p&gt;&lt;hr&gt;&lt;h3&gt;&amp;nbsp;MATEMÁTICA E PESQUISA&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;Matérias:&lt;/strong&gt; Pré-Cálculo, Cálculo Diferencial e Integral I, Álgebra Linear e Geometria Analítica, Métodos e Técnicas de Pesquisa, Projeto e Análise de Algoritmos + IA, TCC I e II.&lt;/p&gt;&lt;p&gt;→ &lt;strong&gt;Pesquisador, Analista de Sistemas, Engenheiro de Software, Programador.&lt;/strong&gt;&lt;/p&gt;&lt;hr&gt;&lt;h3&gt;FORMAÇÃO GERAL&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;Matérias:&lt;/strong&gt; Português Instrumental, Inglês Instrumental, Ética e Legislação.&lt;/p&gt;&lt;p&gt;→ &lt;strong&gt;Analista de Requisitos, Analista de Negócios, Consultor de Sistemas de Informação, Gerente de Projetos, Gerente de Sistemas de Informação, Pesquisador.&lt;/strong&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="770" width="791" x="-450" y="2050" as="geometry" />
        </mxCell>
